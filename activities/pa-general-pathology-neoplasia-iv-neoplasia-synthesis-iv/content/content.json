          "pause": true,
          "displayType": "poster",
          "buttonOnMobile": false,
          "label": "<p>Which of the following tumours is malignant despite carrying the '-oma' suffix?</p>",
          "x": 30,
          "y": 30,
          "width": 40,
          "height": 25,
          "libraryTitle": "Multiple Choice",
          "action": {
            "library": "H5P.MultiChoice 1.16",
            "params": {
              "question": "<p>Which of the following tumours is malignant despite carrying the '-oma' suffix?</p>",
              "answers": [
                {
                  "text": "<div>Adenoma</div>",
                  "correct": false,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>Adenoma is genuinely benign. The '-oma' suffix correctly indicates a benign glandular tumour.</div>",
                    "notChosenFeedback": ""
                  }
                },
                {
                  "text": "<div>Seminoma</div>",
                  "correct": true,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>Correct. Seminoma is a malignant testicular germ cell tumour despite its '-oma' suffix. Other malignant exceptions include melanoma, lymphoma, mesothelioma, hepatoma, and glioma.</div>",
                    "notChosenFeedback": ""
                  }
                },
                {
                  "text": "<div>Lipoma</div>",
                  "correct": false,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>Lipoma is genuinely benign. It is a benign tumour of adipose tissue.</div>",
                    "notChosenFeedback": ""
                  }
                },
                {
                  "text": "<div>Leiomyoma</div>",
                  "correct": false,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>Leiomyoma is genuinely benign. It is a benign smooth muscle tumour, commonly found in the uterus.</div>",
                    "notChosenFeedback": ""
                  }
                }
              ],
              "overallFeedback": [
                {
                  "from": 0,
                  "to": 50,
                  "feedback": "Review the six malignant exceptions to the '-oma' rule: melanoma, lymphoma, seminoma, mesothelioma, hepatoma, and glioma. These are high-yield exam facts."
                },
                {
                  "from": 51,
                  "to": 100,
                  "feedback": "Well done. Seminoma, along with melanoma, lymphoma, mesothelioma, hepatoma, and glioma, are malignant tumours that break the benign '-oma' naming convention."
                }
              ],
              "behaviour": {
