          "displayType": "poster",
          "buttonOnMobile": false,
          "label": "<p>Which of the following tumours is malignant despite carrying the suffix '-oma'?</p>",
          "x": 30,
          "y": 30,
          "width": 40,
          "height": 25,
          "libraryTitle": "Multiple Choice",
          "action": {
            "library": "H5P.MultiChoice 1.16",
            "params": {
              "question": "<p>Which of the following tumours is malignant despite carrying the suffix '-oma'?</p>",
              "answers": [
                {
                  "text": "<div>Adenoma</div>",
                  "correct": false,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>Adenomas are benign glandular tumours that follow standard nomenclature; the malignant counterpart is adenocarcinoma.</div>",
                    "notChosenFeedback": ""
                  }
                },
                {
                  "text": "<div>Leiomyoma</div>",
                  "correct": false,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>Leiomyomas are benign smooth muscle tumours; the malignant counterpart is leiomyosarcoma.</div>",
                    "notChosenFeedback": ""
                  }
                },
                {
                  "text": "<div>Melanoma</div>",
                  "correct": true,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>Correct. Melanoma is malignant despite the '-oma' suffix. The six exceptions are melanoma, lymphoma, seminoma, mesothelioma, hepatoma, and glioma.</div>",
                    "notChosenFeedback": ""
                  }
                },
                {
                  "text": "<div>Lipoma</div>",
                  "correct": false,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>Lipomas are benign fatty tumours following the standard '-oma' = benign rule; the malignant counterpart is liposarcoma.</div>",
                    "notChosenFeedback": ""
                  }
                }
              ],
              "overallFeedback": [
                {
                  "from": 0,
                  "to": 50,
                  "feedback": "Melanoma is malignant despite the '-oma' suffix. Six tumours break this nomenclature rule: melanoma, lymphoma, seminoma, mesothelioma, hepatoma, and glioma — a high-yield exam list."
                },
                {
                  "from": 51,
                  "to": 100,
                  "feedback": "Well done. Memorise the six malignant exceptions to the '-oma' rule: melanoma, lymphoma, seminoma, mesothelioma, hepatoma, and glioma."
                }
              ],
              "behaviour": {
