          "libraryTitle": "Multiple Choice",
          "action": {
            "library": "H5P.MultiChoice 1.16",
            "params": {
              "question": "<p>A midline neck swelling rises when the patient swallows and also when the tongue is protruded. What is the most likely diagnosis?</p>",
              "answers": [
                {
                  "text": "<div>Solitary thyroid nodule</div>",
                  "correct": false,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>A thyroid nodule rises on swallowing because of its attachment to the pretracheal fascia, but it does not move on tongue protrusion.</div>",
                    "notChosenFeedback": ""
                  }
                },
                {
                  "text": "<div>Thyroglossal cyst</div>",
                  "correct": true,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>Correct. Movement on both swallowing and tongue protrusion is the hallmark of a thyroglossal cyst, linked to the foramen caecum via the thyroglossal duct remnant.</div>",
                    "notChosenFeedback": ""
                  }
                },
                {
                  "text": "<div>Multinodular goitre</div>",
                  "correct": false,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>A multinodular goitre rises on swallowing due to the pretracheal fascia attachment, but does not move on tongue protrusion.</div>",
                    "notChosenFeedback": ""
                  }
                },
                {
                  "text": "<div>Cervical lymph node</div>",
                  "correct": false,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>A cervical lymph node does not typically move with either swallowing or tongue protrusion.</div>",
                    "notChosenFeedback": ""
                  }
                }
              ],
              "overallFeedback": [
                {
                  "from": 0,
                  "to": 50,
                  "feedback": "A thyroglossal cyst is distinguished from a thyroid swelling by its additional movement on tongue protrusion — reflecting its embryological connection to the foramen caecum."
                },
                {
                  "from": 51,
                  "to": 100,
                  "feedback": "The thyroglossal duct connects the foramen caecum at the base of the tongue to the thyroid's final position. A cyst arising from its remnant therefore moves on both swallowing and tongue protrusion."
                }
              ],
              "behaviour": {
