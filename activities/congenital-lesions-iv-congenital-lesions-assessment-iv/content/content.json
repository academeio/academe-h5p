          "displayType": "poster",
          "buttonOnMobile": false,
          "label": "<p>Which clinical test best distinguishes structural scoliosis from a non-structura</p>",
          "x": 30,
          "y": 30,
          "width": 40,
          "height": 25,
          "libraryTitle": "Multiple Choice",
          "action": {
            "library": "H5P.MultiChoice 1.16",
            "params": {
              "question": "<p>Which clinical test best distinguishes structural scoliosis from a non-structural (postural) curve?</p>",
              "answers": [
                {
                  "text": "<div>Measuring the Cobb angle on a standing radiograph</div>",
                  "correct": false,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>The Cobb angle quantifies curve severity and confirms scoliosis (≥10°), but both structural and non-structural curves can exceed this threshold on a standing film.</div>",
                    "notChosenFeedback": ""
                  }
                },
                {
                  "text": "<div>Adam's forward bend test</div>",
                  "correct": true,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>On forward bending, fixed vertebral rotation in structural scoliosis produces a rib hump on the convex side that persists, whereas a postural curve straightens out completely.</div>",
                    "notChosenFeedback": ""
                  }
                },
                {
                  "text": "<div>Inspecting for shoulder or pelvic asymmetry</div>",
                  "correct": false,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>Asymmetric shoulders or a tilted pelvis suggest scoliosis clinically but are seen in both structural and postural curves and cannot reliably distinguish between them.</div>",
                    "notChosenFeedback": ""
                  }
                },
                {
                  "text": "<div>Lateral bending radiographs</div>",
                  "correct": false,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>Bending films assess curve flexibility to guide surgical planning but are not the bedside screening test used to separate structural from postural scoliosis.</div>",
                    "notChosenFeedback": ""
                  }
                }
              ],
              "overallFeedback": [
                {
                  "from": 0,
                  "to": 50,
                  "feedback": "The answer is Adam's forward bend test. In structural scoliosis, vertebral rotation is fixed, so the rib hump persists on forward bending; in postural scoliosis, the curve disappears completely."
                },
                {
                  "from": 51,
                  "to": 100,
                  "feedback": "Correct! The Adam's forward bend test reveals the rib hump caused by fixed vertebral rotation — the hallmark of structural scoliosis that postural curves lack."
                }
              ],
              "behaviour": {
                "enableRetry": true,
