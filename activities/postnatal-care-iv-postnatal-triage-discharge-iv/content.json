          "buttonOnMobile": false,
          "label": "<p>What problem does the WHO Medical Eligibility Criteria (MEC) framework solve in </p>",
          "x": 30,
          "y": 30,
          "width": 40,
          "height": 25,
          "libraryTitle": "Multiple Choice",
          "action": {
            "library": "H5P.MultiChoice 1.16",
            "params": {
              "question": "<p>What problem does the WHO Medical Eligibility Criteria (MEC) framework solve in postpartum contraceptive prescribing?</p>",
              "answers": [
                {
                  "text": "<div>It replaces clinical judgement with a rigid prescribing algorithm</div>",
                  "correct": false,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>The WHO MEC supports clinical judgement, not replaces it. It provides structured evidence so clinicians can make informed, individualised decisions.</div>",
                    "notChosenFeedback": ""
                  }
                },
                {
                  "text": "<div>It promotes a single preferred contraceptive method for all postpartum women</div>",
                  "correct": false,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>The WHO MEC classifies multiple methods against individual clinical profiles. It enables individualised matching, not a one-size-fits-all approach.</div>",
                    "notChosenFeedback": ""
                  }
                },
                {
                  "text": "<div>It eliminates both over-restriction and under-restriction by matching methods to individual clinical circumstances</div>",
                  "correct": true,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>Correct. The WHO MEC provides a globally standardised, evidence-based reference that prevents both over-restriction (denying safe methods) and under-restriction (prescribing unsafe ones), enabling individualised contraceptive matching.</div>",
                    "notChosenFeedback": ""
                  }
                },
                {
                  "text": "<div>It restricts contraceptive access to women with no medical comorbidities</div>",
                  "correct": false,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>The WHO MEC does not restrict access. It classifies all methods across a range of clinical conditions, enabling safe prescribing even for women with comorbidities.</div>",
                    "notChosenFeedback": ""
                  }
                }
              ],
              "overallFeedback": [
                {
                  "from": 0,
                  "to": 50,
                  "feedback": "The WHO MEC is an evidence-based classification system that matches contraceptive methods to individual clinical circumstances. Its key contribution is eliminating both over-restriction (denying safe methods) and under-restriction (prescribing unsafe ones)."
                },
                {
                  "from": 51,
                  "to": 100,
                  "feedback": "Correct. The WHO MEC eliminates the guesswork that led to over-restriction and under-restriction — the definitive reference for India's family planning programme, FOGSI guidelines, and the NMC curriculum."
                }
              ],
