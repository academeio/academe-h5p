          "buttonOnMobile": false,
          "label": "<p>Which of the following is NOT one of the five parameters assessed in the APGAR s</p>",
          "x": 30,
          "y": 30,
          "width": 40,
          "height": 25,
          "libraryTitle": "Multiple Choice",
          "action": {
            "library": "H5P.MultiChoice 1.16",
            "params": {
              "question": "<p>Which of the following is NOT one of the five parameters assessed in the APGAR score?</p>",
              "answers": [
                {
                  "text": "<div>Pulse (heart rate)</div>",
                  "correct": false,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>Pulse is the 'P' in APGAR. It scores heart rate as absent (0), below 100 bpm (1), or above 100 bpm (2).</div>",
                    "notChosenFeedback": ""
                  }
                },
                {
                  "text": "<div>Activity (muscle tone)</div>",
                  "correct": false,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>Activity is the second 'A' in APGAR. It scores muscle tone as flaccid (0), some flexion (1), or active movement (2).</div>",
                    "notChosenFeedback": ""
                  }
                },
                {
                  "text": "<div>Alertness (level of consciousness)</div>",
                  "correct": true,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>Correct. The five APGAR parameters are Appearance (colour), Pulse (heart rate), Grimace (reflex irritability), Activity (muscle tone), and Respiration. Consciousness level is not assessed in the APGAR system.</div>",
                    "notChosenFeedback": ""
                  }
                },
                {
                  "text": "<div>Respiration (breathing effort)</div>",
                  "correct": false,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>Respiration is the 'R' in APGAR. It scores breathing effort as absent (0), slow or irregular (1), or vigorous cry (2).</div>",
                    "notChosenFeedback": ""
                  }
                }
              ],
              "overallFeedback": [
                {
                  "from": 0,
                  "to": 50,
                  "feedback": "The APGAR acronym stands for Appearance, Pulse, Grimace, Activity, and Respiration — memorise the acronym and you have all five parameters. Alertness (consciousness) is not assessed."
                },
                {
                  "from": 51,
                  "to": 100,
                  "feedback": "Well done. The acronym APGAR encodes all five parameters — Appearance, Pulse, Grimace, Activity, Respiration. Alertness is not part of this scoring system."
                }
              ],
