          "buttonOnMobile": false,
          "label": "<p>A blood bank receives a freshly separated platelet unit. Which storage condition</p>",
          "x": 30,
          "y": 30,
          "width": 40,
          "height": 25,
          "libraryTitle": "Multiple Choice",
          "action": {
            "library": "H5P.MultiChoice 1.16",
            "params": {
              "question": "<p>A blood bank receives a freshly separated platelet unit. Which storage condition will maintain its viability?</p>",
              "answers": [
                {
                  "text": "<div>Refrigerate at 2–6 °C and use within 42 days</div>",
                  "correct": false,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>This describes packed red blood cell storage. Refrigeration damages platelet function; platelets require room temperature to remain viable.</div>",
                    "notChosenFeedback": ""
                  }
                },
                {
                  "text": "<div>Store at 20–24 °C with continuous gentle agitation and use within 5 days</div>",
                  "correct": true,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>Correct. Platelets must be kept at room temperature with continuous agitation to prevent clumping and maintain gas exchange. Their 5-day shelf-life is the shortest of all blood components, largely due to the risk of bacterial proliferation at room temperature.</div>",
                    "notChosenFeedback": ""
                  }
                },
                {
                  "text": "<div>Freeze at −18 °C and use within 12 months</div>",
                  "correct": false,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>This describes fresh frozen plasma storage. Platelets in their standard preparation cannot survive freeze–thaw cycles.</div>",
                    "notChosenFeedback": ""
                  }
                },
                {
                  "text": "<div>Store at room temperature without agitation and use within 7 days</div>",
                  "correct": false,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>Continuous gentle agitation is essential — without it, platelets aggregate and lose function. The shelf-life is 5 days, not 7.</div>",
                    "notChosenFeedback": ""
                  }
                }
              ],
              "overallFeedback": [
                {
                  "from": 0,
                  "to": 50,
                  "feedback": "Review the storage mnemonic: Red cells 2–6–42 (2–6 °C, 42 days); Platelets room–5 (room temperature, 5 days with agitation); Plasma freeze–12 (−18 °C, 12 months)."
                },
                {
                  "from": 51,
                  "to": 100,
                  "feedback": "Well done. Platelets have the most demanding storage requirements — room temperature, continuous agitation, and only 5 days of usable life."
                }
              ],
              "behaviour": {
                "enableRetry": true,
                "enableSolutionsButton": true,
