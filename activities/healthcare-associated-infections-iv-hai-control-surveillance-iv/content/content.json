          },
          "pause": true,
          "displayType": "poster",
          "buttonOnMobile": false,
          "label": "<p>Which of the following healthcare-associated infections is NOT device-related?</p>",
          "x": 30,
          "y": 30,
          "width": 40,
          "height": 25,
          "libraryTitle": "Multiple Choice",
          "action": {
            "library": "H5P.MultiChoice 1.16",
            "params": {
              "question": "<p>Which of the following healthcare-associated infections is NOT device-related?</p>",
              "answers": [
                {
                  "text": "<div>Catheter-associated urinary tract infection (CAUTI)</div>",
                  "correct": false,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>CAUTI is directly linked to an indwelling urinary catheter — it is defined as a UTI occurring ≥48 hours after catheter insertion.</div>",
                    "notChosenFeedback": ""
                  }
                },
                {
                  "text": "<div>Central line-associated bloodstream infection (CLABSI)</div>",
                  "correct": false,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>CLABSI is defined by the presence of a central venous catheter and is a classic device-related HAI.</div>",
                    "notChosenFeedback": ""
                  }
                },
                {
                  "text": "<div>Ventilator-associated pneumonia (VAP)</div>",
                  "correct": false,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>VAP develops ≥48 hours after endotracheal intubation, making it device-related and preventable through ventilator care bundles.</div>",
                    "notChosenFeedback": ""
                  }
                },
                {
                  "text": "<div>Clostridioides difficile infection (CDI)</div>",
                  "correct": true,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>CDI results from antibiotic-induced disruption of normal gut flora, not from an indwelling device. It is confirmed by detecting C. difficile toxins.</div>",
                    "notChosenFeedback": ""
                  }
                }
              ],
              "overallFeedback": [
                {
                  "from": 0,
                  "to": 50,
                  "feedback": "Review the five HAI types: CAUTI (urinary catheter), CLABSI (central line), and VAP (ventilator) are device-related. SSI relates to a surgical procedure. CDI follows antibiotic use and is not device-related."
                },
                {
                  "from": 51,
                  "to": 100,
                  "feedback": "Correct! CDI is triggered by antibiotic use disrupting normal gut flora, unlike CAUTI, CLABSI, and VAP, which are all associated with indwelling devices and targeted through bundled prevention care."
                }
              ],
              "behaviour": {
