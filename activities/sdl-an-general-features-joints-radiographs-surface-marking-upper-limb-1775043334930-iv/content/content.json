          "width": 40,
          "height": 25,
          "libraryTitle": "Multiple Choice",
          "action": {
            "library": "H5P.MultiChoice 1.16",
            "params": {
              "question": "<p>A patient presents with numbness isolated to the tip of the thumb, with sensation intact in surrounding areas. Since autonomous zones have minimal overlap from adjacent dermatomes, this isolated sensory loss most reliably indicates compression of which nerve root?</p>",
              "answers": [
                {
                  "text": "<div>C5</div>",
                  "correct": false,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>C5 supplies the lateral upper arm over the deltoid region. Its territory does not extend to the thumb.</div>",
                    "notChosenFeedback": ""
                  }
                },
                {
                  "text": "<div>C6</div>",
                  "correct": true,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>Correct. The autonomous zone for C6 is the tip of the thumb — the area with minimal overlap from adjacent dermatomes. Isolated numbness here reliably points to C6 root compression, as occurs with a C5–C6 disc prolapse.</div>",
                    "notChosenFeedback": ""
                  }
                },
                {
                  "text": "<div>C7</div>",
                  "correct": false,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>C7 maps to the middle finger. Its autonomous zone is the tip of the middle finger, not the thumb.</div>",
                    "notChosenFeedback": ""
                  }
                },
                {
                  "text": "<div>T1</div>",
                  "correct": false,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>T1 covers the medial upper arm. It does not supply the thumb or lateral hand.</div>",
                    "notChosenFeedback": ""
                  }
                }
              ],
              "overallFeedback": [
                {
                  "from": 0,
                  "to": 50,
                  "feedback": "The tip of the thumb is the autonomous zone for C6. Autonomous zones have minimal dermatomal overlap, making them the most reliable locations for identifying which nerve root is affected."
                },
                {
                  "from": 51,
                  "to": 100,
                  "feedback": "Excellent. Autonomous zones are clinically valuable because they are the most reliable sites for testing individual nerve roots, owing to minimal overlap from adjacent dermatomes."
                }
              ],
              "behaviour": {
