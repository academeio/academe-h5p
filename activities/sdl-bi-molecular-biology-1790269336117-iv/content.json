            "params": {
              "question": "<p>S-adenosylmethionine serves as the cell's main donor of which chemical group?</p>",
              "answers": [
                {
                  "text": "<div>Acetyl group</div>",
                  "correct": false,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>Coenzyme A is the main acyl-group carrier. S-adenosylmethionine donates methyl groups, not acetyl groups.</div>",
                    "notChosenFeedback": ""
                  }
                },
                {
                  "text": "<div>Methyl group</div>",
                  "correct": true,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>Correct. S-adenosylmethionine (SAM) is the principal methyl donor, used in DNA methylation, catecholamine metabolism, and many other transmethylation reactions.</div>",
                    "notChosenFeedback": ""
                  }
                },
                {
                  "text": "<div>Phosphate group</div>",
                  "correct": false,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>ATP is the primary phosphate-group donor. S-adenosylmethionine specifically donates methyl groups in transmethylation reactions.</div>",
                    "notChosenFeedback": ""
                  }
                },
                {
                  "text": "<div>Amino group</div>",
                  "correct": false,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>Glutamine is the usual amino-group donor in biosynthesis. S-adenosylmethionine is the cell's main methyl donor.</div>",
                    "notChosenFeedback": ""
                  }
                }
              ],
              "overallFeedback": [
                {
