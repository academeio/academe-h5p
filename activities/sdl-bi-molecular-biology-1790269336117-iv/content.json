                  }
                },
                {
                  "text": "<div>Adenylosuccinate synthetase</div>",
                  "correct": false,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>This enzyme acts downstream, converting IMP to adenylosuccinate on the branch leading to AMP. The committed, rate-limiting step is catalysed by glutamine-PRPP amidotransferase.</div>",
                    "notChosenFeedback": ""
                  }
                }
              ],
