          "buttonOnMobile": false,
          "label": "<p>A flexible endoscope contacts intact mucous membranes during a diagnostic proced</p>",
          "x": 30,
          "y": 30,
          "width": 40,
          "height": 25,
          "libraryTitle": "Multiple Choice",
          "action": {
            "library": "H5P.MultiChoice 1.16",
            "params": {
              "question": "<p>A flexible endoscope contacts intact mucous membranes during a diagnostic procedure. According to the Spaulding classification, what is the minimum level of reprocessing required?</p>",
              "answers": [
                {
                  "text": "<div>Low-level disinfection</div>",
                  "correct": false,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>Low-level disinfection is appropriate only for non-critical items that contact intact skin, such as blood-pressure cuffs and stethoscopes.</div>",
                    "notChosenFeedback": ""
                  }
                },
                {
                  "text": "<div>High-level disinfection</div>",
                  "correct": true,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>Correct! A flexible endoscope is a semi-critical item because it contacts intact mucous membranes without penetrating sterile tissue. The Spaulding classification requires at least high-level disinfection for such devices.</div>",
                    "notChosenFeedback": ""
                  }
                },
                {
                  "text": "<div>Intermediate-level disinfection</div>",
                  "correct": false,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>Intermediate-level disinfection applies to non-critical items. An endoscope contacting mucous membranes is classified as semi-critical and needs high-level disinfection as the minimum.</div>",
                    "notChosenFeedback": ""
                  }
                },
                {
                  "text": "<div>Full sterilisation</div>",
                  "correct": false,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>Full sterilisation is reserved for critical items that enter sterile tissue or the vascular system, such as scalpel blades and surgical implants. A semi-critical item needs high-level disinfection, not full sterilisation.</div>",
                    "notChosenFeedback": ""
                  }
                }
              ],
              "overallFeedback": [
                {
                  "from": 0,
                  "to": 50,
                  "feedback": "Review the Spaulding classification: critical items (sterile tissue contact) → sterilise; semi-critical items (mucous membrane contact) → high-level disinfection; non-critical items (intact skin only) → low or intermediate disinfection."
                },
                {
                  "from": 51,
                  "to": 100,
                  "feedback": "Well done! The Spaulding classification fixes the minimum acceptable reprocessing level for every reusable device — and you must never downgrade below it."
                }
              ],
              "behaviour": {
                "enableRetry": true,
