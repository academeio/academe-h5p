          "buttonOnMobile": false,
          "label": "<p>After a surgical procedure, used intravenous tubing and examination gloves (with</p>",
          "x": 30,
          "y": 30,
          "width": 40,
          "height": 25,
          "libraryTitle": "Multiple Choice",
          "action": {
            "library": "H5P.MultiChoice 1.16",
            "params": {
              "question": "<p>After a surgical procedure, used intravenous tubing and examination gloves (without needles) must be placed in which colour-coded bin?</p>",
              "answers": [
                {
                  "text": "<div>Yellow</div>",
                  "correct": false,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>Yellow bins receive anatomical waste, soiled dressings, expired medicines, and chemical waste. These items are incinerated or deep-buried.</div>",
                    "notChosenFeedback": ""
                  }
                },
                {
                  "text": "<div>White translucent</div>",
                  "correct": false,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>The white translucent puncture-proof container is exclusively for sharps — needles, scalpel blades, and lancets.</div>",
                    "notChosenFeedback": ""
                  }
                },
                {
                  "text": "<div>Blue</div>",
                  "correct": false,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>Blue bins hold broken glassware and metallic body implants, which are disinfected and then recycled.</div>",
                    "notChosenFeedback": ""
                  }
                },
                {
                  "text": "<div>Red</div>",
                  "correct": true,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>Correct! Red bins receive contaminated recyclable plastics, including IV tubing, gloves, and syringes without needles. After autoclaving, these items are shredded and recycled.</div>",
                    "notChosenFeedback": ""
                  }
                }
              ],
              "overallFeedback": [
                {
                  "from": 0,
                  "to": 50,
                  "feedback": "Remember the four-colour system: yellow for anatomical and chemical waste (incinerate); red for contaminated recyclable plastics (autoclave, then shred); white translucent for sharps only (autoclave, then encapsulate); blue for glass and metallic implants (disinfect, then recycle)."
                },
                {
                  "from": 51,
                  "to": 100,
                  "feedback": "Well done. Segregation at source — placing each item in the correct bin at the moment and place you generate it — is the governing principle of biomedical waste management."
                }
              ],
              "behaviour": {
