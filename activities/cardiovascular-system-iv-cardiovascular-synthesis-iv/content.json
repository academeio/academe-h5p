          "displayType": "poster",
          "buttonOnMobile": false,
          "label": "<p>Which of the following situations specifically warrants a full cardiovascular ex</p>",
          "x": 30,
          "y": 30,
          "width": 40,
          "height": 25,
          "libraryTitle": "Multiple Choice",
          "action": {
            "library": "H5P.MultiChoice 1.16",
            "params": {
              "question": "<p>Which of the following situations specifically warrants a full cardiovascular examination in a child?</p>",
              "answers": [
                {
                  "text": "<div>A child with isolated constipation and normal growth parameters</div>",
                  "correct": false,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>Constipation alone is not among the clinical indications for a focused cardiovascular examination in children.</div>",
                    "notChosenFeedback": ""
                  }
                },
                {
                  "text": "<div>An asymptomatic child with Down syndrome presenting for a routine check-up</div>",
                  "correct": true,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>Children with Down syndrome, Turner syndrome, or Marfan syndrome carry known congenital heart risks and warrant cardiovascular examination even in the absence of cardiac symptoms.</div>",
                    "notChosenFeedback": ""
                  }
                },
                {
                  "text": "<div>A child with a mild upper respiratory tract infection and no audible murmur</div>",
                  "correct": false,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>An uncomplicated upper respiratory infection without a murmur or other cardiac signs does not specifically indicate a focused cardiovascular examination.</div>",
                    "notChosenFeedback": ""
                  }
                },
                {
                  "text": "<div>A child presenting solely for a scheduled vaccination with no clinical concerns</div>",
                  "correct": false,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>A routine vaccination visit without any cardiac symptoms or risk factors does not specifically require a focused cardiovascular examination.</div>",
                    "notChosenFeedback": ""
                  }
                }
              ],
              "overallFeedback": [
                {
                  "from": 0,
                  "to": 50,
                  "feedback": "The narration highlighted several indications for cardiovascular examination, including children with Down syndrome, Turner syndrome, or Marfan syndrome, who carry known cardiac risks even when asymptomatic."
                },
                {
                  "from": 51,
                  "to": 100,
                  "feedback": "Correct! Genetic syndromes such as Down syndrome are associated with congenital heart defects (e.g. atrioventricular septal defect), making a thorough cardiovascular examination essential regardless of symptoms."
                }
              ],
              "behaviour": {
