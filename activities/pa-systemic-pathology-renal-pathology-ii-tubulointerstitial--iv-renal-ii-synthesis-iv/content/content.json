          "buttonOnMobile": false,
          "label": "<p>A man with gout develops renal colic. Plain abdominal X-ray shows no visible sto</p>",
          "x": 30,
          "y": 30,
          "width": 40,
          "height": 25,
          "libraryTitle": "Multiple Choice",
          "action": {
            "library": "H5P.MultiChoice 1.16",
            "params": {
              "question": "<p>A man with gout develops renal colic. Plain abdominal X-ray shows no visible stone, but CT confirms a calculus. What type of stone is this most likely to be?</p>",
              "answers": [
                {
                  "text": "<div>Calcium oxalate</div>",
                  "correct": false,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>Calcium-containing stones are radiopaque and would be visible on plain film — this does not fit a stone invisible on X-ray.</div>",
                    "notChosenFeedback": ""
                  }
                },
                {
                  "text": "<div>Struvite</div>",
                  "correct": false,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>Struvite stones are radiopaque and can grow large enough to form a staghorn calculus visible on plain film.</div>",
                    "notChosenFeedback": ""
                  }
                },
                {
                  "text": "<div>Uric acid</div>",
                  "correct": true,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>Correct. Uric acid stones form in the acidic urine of gout or tumour lysis syndrome and are radiolucent on plain X-ray, only becoming visible on CT — exactly the pattern described.</div>",
                    "notChosenFeedback": ""
                  }
                },
                {
                  "text": "<div>Cystine</div>",
                  "correct": false,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>Cystine stones are hereditary and associated with hexagonal urinary crystals, not with gout.</div>",
                    "notChosenFeedback": ""
                  }
                }
              ],
              "overallFeedback": [
                {
                  "from": 0,
                  "to": 50,
                  "feedback": "Remember the imaging rule: calcium stones stand out on plain film, uric acid stones disappear on plain film but show on CT — and uric acid stones are linked to gout and tumour lysis syndrome."
                },
                {
                  "from": 51,
                  "to": 100,
                  "feedback": "Correct — gout plus a plain-film-invisible, CT-visible stone is the classic uric acid stone pattern."
                }
              ],
              "behaviour": {
                "enableRetry": true,
