          "buttonOnMobile": false,
          "label": "<p>Which finding on renal biopsy is diagnostic of amyloidosis?</p>",
          "x": 30,
          "y": 30,
          "width": 40,
          "height": 25,
          "libraryTitle": "Multiple Choice",
          "action": {
            "library": "H5P.MultiChoice 1.16",
            "params": {
              "question": "<p>Which finding on renal biopsy is diagnostic of amyloidosis?</p>",
              "answers": [
                {
                  "text": "<div>Wire-loop deposits on light microscopy</div>",
                  "correct": false,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>Wire-loop deposits are characteristic of Class IV diffuse proliferative lupus nephritis, where subendothelial immune deposits thicken the capillary wall.</div>",
                    "notChosenFeedback": ""
                  }
                },
                {
                  "text": "<div>Apple-green birefringence on Congo red staining under polarised light</div>",
                  "correct": true,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>Congo red binds the beta-pleated sheet structure of amyloid fibrils. Under polarised light, this produces the diagnostic apple-green birefringence, confirming amyloid deposition in the mesangium and capillary walls.</div>",
                    "notChosenFeedback": ""
                  }
                },
                {
                  "text": "<div>Onion-skin hyperplastic arteriolitis</div>",
                  "correct": false,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>Onion-skin hyperplastic arteriolitis is the hallmark of malignant hypertensive nephrosclerosis, reflecting severe vascular damage in a hypertensive emergency.</div>",
                    "notChosenFeedback": ""
                  }
                },
                {
                  "text": "<div>Tram-tracking on periodic acid-Schiff stain</div>",
                  "correct": false,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>Tram-tracking (double-contour basement membrane) is the signature of membranoproliferative GN, caused by mesangial cell interposition between the endothelium and the GBM.</div>",
                    "notChosenFeedback": ""
                  }
                }
              ],
              "overallFeedback": [
                {
                  "from": 0,
                  "to": 50,
                  "feedback": "Each systemic glomerular disease has a signature biopsy finding: apple-green birefringence = amyloidosis; wire-loop deposits = lupus Class IV; onion-skin arteriolitis = malignant HTN; tram-tracking = MPGN."
                },
                {
                  "from": 51,
                  "to": 100,
                  "feedback": "Congo red staining with apple-green birefringence under polarised light is the gold-standard diagnostic test for amyloidosis, applicable to both AL (light-chain) and AA (reactive) types."
                }
              ],
              "behaviour": {
                "enableRetry": true,
