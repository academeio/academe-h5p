          "label": "<p>According to WHO criteria, what is the haemoglobin threshold below which anaemia</p>",
          "x": 30,
          "y": 30,
          "width": 40,
          "height": 25,
          "libraryTitle": "Multiple Choice",
          "action": {
            "library": "H5P.MultiChoice 1.16",
            "params": {
              "question": "<p>According to WHO criteria, what is the haemoglobin threshold below which anaemia is diagnosed in non-pregnant women aged 15 years and older?</p>",
              "answers": [
                {
                  "text": "<div>11 g/dL</div>",
                  "correct": false,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>This threshold applies to pregnant women and children aged 6 months to 4 years, not to non-pregnant adult women.</div>",
                    "notChosenFeedback": ""
                  }
                },
                {
                  "text": "<div>12 g/dL</div>",
                  "correct": true,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>Correct. The WHO sets 12 g/dL for non-pregnant women aged ≥15, while men require 13 g/dL and pregnant women 11 g/dL.</div>",
                    "notChosenFeedback": ""
                  }
                },
                {
                  "text": "<div>13 g/dL</div>",
                  "correct": false,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>This is the WHO threshold for adult men aged 15 and older, not for women.</div>",
                    "notChosenFeedback": ""
                  }
                },
                {
                  "text": "<div>10.5 g/dL</div>",
                  "correct": false,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>This is the second-trimester cut-off for pregnant women, not the general threshold for non-pregnant women.</div>",
                    "notChosenFeedback": ""
                  }
                }
              ],
              "overallFeedback": [
                {
                  "from": 0,
                  "to": 50,
                  "feedback": "Review the WHO haemoglobin thresholds: non-pregnant women ≥15 years = 12 g/dL, men ≥15 years = 13 g/dL, pregnant women = 11 g/dL."
                },
                {
                  "from": 51,
                  "to": 100,
                  "feedback": "Correct! WHO defines different haemoglobin thresholds by age, sex, and pregnancy status — remembering these is essential for accurate diagnosis."
                }
              ],
