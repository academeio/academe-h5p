          "displayType": "poster",
          "buttonOnMobile": false,
          "label": "<p>A 46-year-old woman's breast biopsy shows atypical lobular hyperplasia. Her moth</p>",
          "x": 30,
          "y": 30,
          "width": 40,
          "height": 25,
          "libraryTitle": "Multiple Choice",
          "action": {
            "library": "H5P.MultiChoice 1.16",
            "params": {
              "question": "<p>A 46-year-old woman's breast biopsy shows atypical lobular hyperplasia. Her mother had breast cancer. What is her approximate relative risk of developing invasive breast carcinoma compared with baseline?</p>",
              "answers": [
                {
                  "text": "<div>No increased risk</div>",
                  "correct": false,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>No increased risk applies to non-proliferative lesions such as simple cysts, apocrine metaplasia and mild fibrosis. Atypical hyperplasia is proliferative and carries a clearly raised risk.</div>",
                    "notChosenFeedback": ""
                  }
                },
                {
                  "text": "<div>About 1.5 to 2 times</div>",
                  "correct": false,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>This is the risk for proliferative lesions without atypia, such as usual ductal hyperplasia or sclerosing adenosis. Atypia moves the lesion up a tier.</div>",
                    "notChosenFeedback": ""
                  }
                },
                {
                  "text": "<div>About 4 to 5 times</div>",
                  "correct": false,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>This is the risk for atypical hyperplasia alone. Her positive family history pushes the risk higher still.</div>",
                    "notChosenFeedback": ""
                  }
                },
                {
                  "text": "<div>About 8 to 10 times</div>",
                  "correct": true,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>Atypical hyperplasia (4 to 5 times) combined with a positive family history raises the relative risk to 8 to 10 times. This is the highest risk in the benign category.</div>",
                    "notChosenFeedback": ""
                  }
                }
              ],
              "overallFeedback": [
                {
                  "from": 0,
                  "to": 50,
                  "feedback": "The gradient is: non-proliferative, no increased risk; proliferative without atypia, 1.5 to 2 times; atypia, 4 to 5 times; atypia plus a family history, 8 to 10 times."
                },
                {
                  "from": 51,
                  "to": 100,
                  "feedback": "Correct. The risk gradient runs 1x, then 1.5 to 2x, then 4 to 5x with atypia, then 8 to 10x when atypia is combined with a family history."
                }
              ],
              "behaviour": {
