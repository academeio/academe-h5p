          "buttonOnMobile": false,
          "label": "<p>Which marker is described as the single most useful for confirming lymphoid line</p>",
          "x": 30,
          "y": 30,
          "width": 40,
          "height": 25,
          "libraryTitle": "Multiple Choice",
          "action": {
            "library": "H5P.MultiChoice 1.16",
            "params": {
              "question": "<p>Which marker is described as the single most useful for confirming lymphoid lineage when distinguishing ALL from AML?</p>",
              "answers": [
                {
                  "text": "<div>Myeloperoxidase (MPO)</div>",
                  "correct": false,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>MPO is positive in AML blasts (≥3% required) and confirms myeloid lineage. It is negative in ALL.</div>",
                    "notChosenFeedback": ""
                  }
                },
                {
                  "text": "<div>CD34</div>",
                  "correct": false,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>CD34 is a haematopoietic stem cell marker present in both AML and ALL. It cannot distinguish between the two lineages.</div>",
                    "notChosenFeedback": ""
                  }
                },
                {
                  "text": "<div>Terminal deoxynucleotidyl transferase (TdT)</div>",
                  "correct": true,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>Correct. TdT is positive in both B-ALL and T-ALL but negative in most AML, making it the single clearest marker for lymphoid lineage.</div>",
                    "notChosenFeedback": ""
                  }
                },
                {
                  "text": "<div>CD117</div>",
                  "correct": false,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>CD117 (c-Kit) is a myeloid marker that identifies AML blasts. It is not a lymphoid marker.</div>",
                    "notChosenFeedback": ""
                  }
                }
              ],
              "overallFeedback": [
                {
                  "from": 0,
                  "to": 50,
                  "feedback": "TdT (terminal deoxynucleotidyl transferase) is the single clearest lymphoid marker — positive in both B-ALL and T-ALL, negative in most AML. MPO confirms myeloid lineage; CD34 and CD117 cannot distinguish lineages on their own."
                },
                {
                  "from": 51,
                  "to": 100,
                  "feedback": "TdT is positive in both B-ALL and T-ALL but negative in most AML, making it the key lymphoid marker. Combined with lineage-specific CD panels (CD19/CD10 for B-ALL; CD3/CD7 for T-ALL), it provides definitive lineage assignment."
                }
              ],
              "behaviour": {
                "enableRetry": true,
                "enableSolutionsButton": true,
                "enableCheckButton": true,
