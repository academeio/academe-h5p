          "pause": true,
          "displayType": "poster",
          "buttonOnMobile": false,
          "label": "<p>What minimum percentage of blasts in the bone marrow or blood defines acute leuk</p>",
          "x": 30,
          "y": 30,
          "width": 40,
          "height": 25,
          "libraryTitle": "Multiple Choice",
          "action": {
            "library": "H5P.MultiChoice 1.16",
            "params": {
              "question": "<p>What minimum percentage of blasts in the bone marrow or blood defines acute leukaemia under the WHO 2001 criteria?</p>",
              "answers": [
                {
                  "text": "<div>10%</div>",
                  "correct": false,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>10% is not a recognised diagnostic threshold. The WHO lowered the previous FAB cut-off from 30% to 20%, not to 10%.</div>",
                    "notChosenFeedback": ""
                  }
                },
                {
                  "text": "<div>20%</div>",
                  "correct": true,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>Correct. The WHO 2001 criteria set 20% as the threshold, replacing the older FAB cut-off of 30%. However, certain chromosomal abnormalities — t(8;21), t(15;17), and inv(16) — can diagnose AML even below this threshold.</div>",
                    "notChosenFeedback": ""
                  }
                },
                {
                  "text": "<div>25%</div>",
                  "correct": false,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>25% is not a standard threshold. The WHO defined acute leukaemia as ≥20% blasts in the marrow or blood.</div>",
                    "notChosenFeedback": ""
                  }
                },
                {
                  "text": "<div>30%</div>",
                  "correct": false,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>30% was the older French-American-British (FAB) threshold, which was replaced by the WHO in 2001 with a lower cut-off of 20%.</div>",
                    "notChosenFeedback": ""
                  }
                }
              ],
              "overallFeedback": [
                {
                  "from": 0,
                  "to": 50,
                  "feedback": "The WHO 2001 criteria lowered the diagnostic blast threshold from 30% (FAB) to 20%. Certain translocations — t(8;21), t(15;17), and inv(16) — are exceptions that diagnose AML even below 20%."
                },
                {
                  "from": 51,
                  "to": 100,
                  "feedback": "The WHO 2001 criteria define acute leukaemia as ≥20% blasts, replacing the older FAB threshold of 30%. Remember the exceptions: specific cytogenetic lesions can diagnose AML regardless of blast count."
                }
              ],
              "behaviour": {
