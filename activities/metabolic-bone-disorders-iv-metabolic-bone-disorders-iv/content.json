          "libraryTitle": "Multiple Choice",
          "action": {
            "library": "H5P.MultiChoice 1.16",
            "params": {
              "question": "<p>A 62-year-old post-menopausal woman undergoes DEXA scanning. Her lowest T-score is −2.0. How should this result be classified?</p>",
              "answers": [
                {
                  "text": "<div>Normal bone density</div>",
                  "correct": false,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>A T-score of −1.0 or above is considered normal. This patient's score falls below that threshold.</div>",
                    "notChosenFeedback": ""
                  }
                },
                {
                  "text": "<div>Osteopenia</div>",
                  "correct": true,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>Correct. A T-score between −1.0 and −2.5 indicates osteopenia — reduced bone mass that has not yet reached the threshold for osteoporosis but warrants monitoring.</div>",
                    "notChosenFeedback": ""
                  }
                },
                {
                  "text": "<div>Osteoporosis</div>",
                  "correct": false,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>Osteoporosis requires a T-score at or below −2.5, or a fragility fracture. A score of −2.0 falls in the osteopenia range.</div>",
                    "notChosenFeedback": ""
                  }
                },
                {
                  "text": "<div>Established osteoporosis</div>",
                  "correct": false,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>Established osteoporosis refers to a fragility fracture in the setting of low bone density. No fracture is described here.</div>",
                    "notChosenFeedback": ""
                  }
                }
              ],
              "overallFeedback": [
                {
                  "from": 0,
                  "to": 50,
                  "feedback": "Review the WHO T-score thresholds: normal ≥ −1.0, osteopenia −1.0 to −2.5, osteoporosis ≤ −2.5. A fragility fracture alone also confirms osteoporosis regardless of the T-score."
                },
                {
                  "from": 51,
                  "to": 100,
                  "feedback": "Well done. The WHO classification places T-scores between −1.0 and −2.5 in the osteopenia category — a risk state that warrants lifestyle modification and monitoring."
                }
              ],
