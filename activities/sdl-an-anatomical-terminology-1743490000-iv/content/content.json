          "buttonOnMobile": false,
          "label": "<p>Which of the following statements correctly uses anatomical directional terminol</p>",
          "x": 30,
          "y": 30,
          "width": 40,
          "height": 25,
          "libraryTitle": "Multiple Choice",
          "action": {
            "library": "H5P.MultiChoice 1.16",
            "params": {
              "question": "<p>Which of the following statements correctly uses anatomical directional terminology?</p>",
              "answers": [
                {
                  "text": "<div>The knee is proximal to the ankle</div>",
                  "correct": true,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>Correct. Proximal means closer to where the limb attaches to the trunk. The knee is closer to the hip than the ankle is, making it proximal to the ankle.</div>",
                    "notChosenFeedback": ""
                  }
                },
                {
                  "text": "<div>The skin is deep to the muscles</div>",
                  "correct": false,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>Incorrect. Skin is superficial to the muscles — it lies closer to the body surface. Deep structures are farther from the surface, such as bones deep to the muscles.</div>",
                    "notChosenFeedback": ""
                  }
                },
                {
                  "text": "<div>The little finger is lateral to the thumb</div>",
                  "correct": false,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>Incorrect. In the anatomical position (palms forward), the thumb sits on the lateral side (farther from the midline) and the little finger on the medial side (closer to the midline).</div>",
                    "notChosenFeedback": ""
                  }
                },
                {
                  "text": "<div>The sternum is posterior to the vertebral column</div>",
                  "correct": false,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>Incorrect. The sternum is anterior — toward the front of the body. The vertebral column is posterior to the sternum, not the other way around.</div>",
                    "notChosenFeedback": ""
                  }
                }
              ],
              "overallFeedback": [
                {
                  "from": 0,
                  "to": 50,
                  "feedback": "Review the five directional pairs: superior/inferior, anterior/posterior, medial/lateral, proximal/distal, and superficial/deep. Each pair is defined relative to the anatomical position."
                },
                {
                  "from": 51,
                  "to": 100,
                  "feedback": "Well done. You can apply directional terms to anatomical relationships beyond the examples given in the lecture."
                }
              ],
              "behaviour": {
