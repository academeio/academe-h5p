          "pause": true,
          "displayType": "poster",
          "buttonOnMobile": false,
          "label": "<p>You are giving chest compressions to an adult in cardiac arrest. What rate and d</p>",
          "x": 30,
          "y": 30,
          "width": 40,
          "height": 25,
          "libraryTitle": "Multiple Choice",
          "action": {
            "library": "H5P.MultiChoice 1.16",
            "params": {
              "question": "<p>You are giving chest compressions to an adult in cardiac arrest. What rate and depth should you deliver?</p>",
              "answers": [
                {
                  "text": "<div>60–80 per minute, 3–4 cm deep</div>",
                  "correct": false,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>This is too slow and too shallow. Compressions at this rate and depth will not generate adequate coronary and cerebral perfusion.</div>",
                    "notChosenFeedback": ""
                  }
                },
                {
                  "text": "<div>100–120 per minute, 5–6 cm deep</div>",
                  "correct": true,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>Correct. This rate and depth, with full chest recoil between compressions, generates the blood flow needed to keep the brain and heart oxygenated until circulation is restored.</div>",
                    "notChosenFeedback": ""
                  }
                },
                {
                  "text": "<div>120–140 per minute, 2–3 cm deep</div>",
                  "correct": false,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>The rate here is too fast and the depth far too shallow — shallow compressions fail to generate enough forward blood flow, regardless of rate.</div>",
                    "notChosenFeedback": ""
                  }
                },
                {
                  "text": "<div>80–100 per minute, 6–8 cm deep</div>",
                  "correct": false,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>This depth exceeds the recommended maximum and risks rib or sternal injury; the rate is also below the recommended range.</div>",
                    "notChosenFeedback": ""
                  }
                }
              ],
              "overallFeedback": [
                {
                  "from": 0,
                  "to": 50,
                  "feedback": "The correct technique is 100–120 compressions per minute at a depth of 5–6 cm, with full chest recoil each time."
                },
                {
                  "from": 51,
                  "to": 100,
                  "feedback": "Correct — 100 to 120 compressions per minute, 5 to 6 cm deep, with full recoil, is the target for adult CPR."
                }
              ],
