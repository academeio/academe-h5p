            "params": {
              "question": "<p>Which treatment method is mandated under BMW Rules 2016 for yellow-bag anatomical waste such as human organs and tissues?</p>",
              "answers": [
                {
                  "text": "<div>Autoclaving at 121°C for 30 minutes</div>",
                  "correct": false,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>Autoclaving is used for red-bag recyclable plastics and white-container sharps, not for anatomical waste, which requires complete thermal destruction.</div>",
                    "notChosenFeedback": ""
                  }
                },
                {
                  "text": "<div>Incineration with primary chamber temperature ≥800°C</div>",
                  "correct": true,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>Correct. Dual-chamber incineration (≥800°C primary, ≥1,050°C secondary) is mandated for anatomical waste, achieving 90–95% volume reduction and rendering all infectious agents non-viable.</div>",
                    "notChosenFeedback": ""
                  }
                },
                {
                  "text": "<div>Chemical disinfection with 1% sodium hypochlorite</div>",
                  "correct": false,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>Chemical disinfection is used for liquid waste and surface decontamination, not for solid anatomical waste which requires high-temperature thermal destruction.</div>",
                    "notChosenFeedback": ""
                  }
                },
                {
                  "text": "<div>Deep burial in a cement-lined pit</div>",
                  "correct": false,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>Deep burial is permitted only in remote areas lacking access to a Common Biomedical Waste Treatment Facility (CBWTF), not as a routine method for anatomical waste in hospitals.</div>",
                    "notChosenFeedback": ""
                  }
                }
              ],
              "overallFeedback": [
