          "buttonOnMobile": false,
          "label": "<p>A 46-year-old man records a blood pressure of 134/86 mmHg on two separate visits</p>",
          "x": 30,
          "y": 30,
          "width": 40,
          "height": 25,
          "libraryTitle": "Multiple Choice",
          "action": {
            "library": "H5P.MultiChoice 1.16",
            "params": {
              "question": "<p>A 46-year-old man records a blood pressure of 134/86 mmHg on two separate visits. Under which classification is this reading categorised as hypertension?</p>",
              "answers": [
                {
                  "text": "<div>JNC 7</div>",
                  "correct": false,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>Under JNC 7, hypertension begins at 140/90 mmHg. A reading of 134/86 falls into the pre-hypertension category (120–139/80–89).</div>",
                    "notChosenFeedback": ""
                  }
                },
                {
                  "text": "<div>ACC/AHA 2017</div>",
                  "correct": true,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>The ACC/AHA 2017 guideline sets hypertension at 130/80 mmHg. A reading of 134/86 qualifies as Stage 1 hypertension (130–139/80–89).</div>",
                    "notChosenFeedback": ""
                  }
                },
                {
                  "text": "<div>Indian Guidelines on Hypertension, 4th edition</div>",
                  "correct": false,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>IGH-IV adopts the JNC 7 threshold of 140/90 mmHg, so 134/86 falls below the hypertension cut-off in this system.</div>",
                    "notChosenFeedback": ""
                  }
                },
                {
                  "text": "<div>Both JNC 7 and ACC/AHA 2017</div>",
                  "correct": false,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>Only the ACC/AHA 2017 system classifies this reading as hypertension (≥130/80). Under JNC 7, it remains pre-hypertension.</div>",
                    "notChosenFeedback": ""
                  }
                }
              ],
              "overallFeedback": [
                {
                  "from": 0,
                  "to": 50,
                  "feedback": "The ACC/AHA 2017 guideline lowered the hypertension threshold to 130/80 mmHg, while JNC 7 and Indian guidelines retain the threshold at 140/90. A reading of 134/86 is Stage 1 under ACC/AHA 2017 but only pre-hypertension under JNC 7."
                },
                {
                  "from": 51,
                  "to": 100,
                  "feedback": "Correct. The same reading can be 'hypertension' or 'pre-hypertension' depending on which guideline you cite. Always state which classification system you are using — this avoids clinical miscommunication."
                }
              ],
              "behaviour": {
