          "width": 40,
          "height": 25,
          "libraryTitle": "Multiple Choice",
          "action": {
            "library": "H5P.MultiChoice 1.16",
            "params": {
              "question": "<p>As per the WHO global strategy to eliminate cervical cancer, what proportion of women should be screened with a high-performance test by age 35, and again by age 45?</p>",
              "answers": [
                {
                  "text": "<div>90%</div>",
                  "correct": false,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>90% is the target for HPV vaccination coverage in girls by age 15, not the screening target.</div>",
                    "notChosenFeedback": ""
                  }
                },
                {
                  "text": "<div>70%</div>",
                  "correct": true,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>Correct. The WHO 2030 strategy targets 70% of women screened with a high-performance test by age 35 and again by age 45, alongside 90% vaccination and 90% treatment coverage.</div>",
                    "notChosenFeedback": ""
                  }
                },
                {
                  "text": "<div>50%</div>",
                  "correct": false,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>50% does not correspond to any of the three WHO 2030 targets (90-70-90).</div>",
                    "notChosenFeedback": ""
                  }
                },
                {
                  "text": "<div>100%</div>",
                  "correct": false,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>None of the WHO 2030 targets are set at 100%; the framework uses 90-70-90 as achievable global benchmarks.</div>",
                    "notChosenFeedback": ""
                  }
                }
              ],
              "overallFeedback": [
                {
                  "from": 0,
                  "to": 50,
                  "feedback": "The WHO 2030 elimination strategy is remembered as 90-70-90: 90% of girls vaccinated by 15, 70% of women screened by 35 and 45, and 90% of women with cervical disease treated."
                },
                {
                  "from": 51,
                  "to": 100,
                  "feedback": "Right — remember the WHO framework as 90-70-90: 90% vaccinated, 70% screened, 90% treated."
                }
              ],
