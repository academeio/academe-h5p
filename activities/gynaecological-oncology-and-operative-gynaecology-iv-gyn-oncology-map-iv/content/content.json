          "libraryTitle": "Multiple Choice",
          "action": {
            "library": "H5P.MultiChoice 1.16",
            "params": {
              "question": "<p>A woman with a confirmed BRCA1 mutation asks about her lifetime risk of ovarian cancer. Which figure is correct?</p>",
              "answers": [
                {
                  "text": "<div>Around 44%</div>",
                  "correct": true,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>Correct. BRCA1 mutations carry a lifetime ovarian cancer risk of approximately 44%, the highest of the genetic risk factors discussed.</div>",
                    "notChosenFeedback": ""
                  }
                },
                {
                  "text": "<div>Around 17%</div>",
                  "correct": false,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>17% is closer to the lifetime risk associated with BRCA2 mutations, not BRCA1.</div>",
                    "notChosenFeedback": ""
                  }
                },
                {
                  "text": "<div>Around 6-10%</div>",
                  "correct": false,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>6-10% is the lifetime ovarian cancer risk associated with Lynch syndrome, which is lower than BRCA1.</div>",
                    "notChosenFeedback": ""
                  }
                },
                {
                  "text": "<div>Around 1%</div>",
                  "correct": false,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>1% is the baseline lifetime risk in the general population, far below the risk conferred by a BRCA1 mutation.</div>",
                    "notChosenFeedback": ""
                  }
                }
              ],
              "overallFeedback": [
                {
                  "from": 0,
                  "to": 50,
                  "feedback": "Remember the gradient: BRCA1 ~44%, BRCA2 ~17%, Lynch syndrome ~6-10%, general population ~1%. BRCA1 carries the highest lifetime risk of the group."
                },
                {
                  "from": 51,
                  "to": 100,
                  "feedback": "Correct — BRCA1 (~44%) carries a higher ovarian cancer risk than BRCA2 (~17%) or Lynch syndrome (~6-10%), against a general population baseline of ~1%."
                }
              ],
