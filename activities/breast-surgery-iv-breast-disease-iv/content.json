          "buttonOnMobile": false,
          "label": "<p>Which pattern of nipple discharge is most suggestive of an underlying duct papil</p>",
          "x": 30,
          "y": 30,
          "width": 40,
          "height": 25,
          "libraryTitle": "Multiple Choice",
          "action": {
            "library": "H5P.MultiChoice 1.16",
            "params": {
              "question": "<p>Which pattern of nipple discharge is most suggestive of an underlying duct papilloma or carcinoma?</p>",
              "answers": [
                {
                  "text": "<div>Bilateral milky discharge</div>",
                  "correct": false,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>Bilateral milky discharge (galactorrhoea) is usually hormonal and benign, commonly caused by hyperprolactinaemia or medication side effects.</div>",
                    "notChosenFeedback": ""
                  }
                },
                {
                  "text": "<div>Blood-stained discharge from a single duct</div>",
                  "correct": true,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>Correct. Single-duct blood-stained or serous discharge raises concern for an intraductal papilloma or carcinoma and warrants further investigation with imaging and biopsy.</div>",
                    "notChosenFeedback": ""
                  }
                },
                {
                  "text": "<div>Bilateral greenish discharge</div>",
                  "correct": false,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>Bilateral green discharge is typically associated with fibrocystic changes and is not a red flag for malignancy.</div>",
                    "notChosenFeedback": ""
                  }
                },
                {
                  "text": "<div>Clear discharge from both nipples on compression</div>",
                  "correct": false,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>Bilateral clear discharge elicited by compression is usually physiological and does not carry the same level of concern as unilateral blood-stained discharge.</div>",
                    "notChosenFeedback": ""
                  }
                }
              ],
              "overallFeedback": [
                {
                  "from": 0,
                  "to": 50,
                  "feedback": "The key red flag is blood-stained or serous discharge from a single duct. Bilateral milky or green discharge is far less concerning and usually benign."
                },
                {
                  "from": 51,
                  "to": 100,
                  "feedback": "Well done. Blood-stained or serous discharge from a single duct is a red flag that requires triple assessment to exclude papilloma or carcinoma."
                }
              ],
              "behaviour": {
