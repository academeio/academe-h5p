          "pause": true,
          "displayType": "poster",
          "buttonOnMobile": false,
          "label": "<p>A 50-year-old man reports joint stiffness each morning that clears within 20 min</p>",
          "x": 30,
          "y": 30,
          "width": 40,
          "height": 25,
          "libraryTitle": "Multiple Choice",
          "action": {
            "library": "H5P.MultiChoice 1.16",
            "params": {
              "question": "<p>A 50-year-old man reports joint stiffness each morning that clears within 20 minutes, and his knee pain worsens after a long walk. Which diagnosis does this clinical pattern most favour?</p>",
              "answers": [
                {
                  "text": "<div>Rheumatoid arthritis</div>",
                  "correct": false,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>RA causes morning stiffness lasting over 60 minutes that improves with activity — the opposite of this patient's pattern.</div>",
                    "notChosenFeedback": ""
                  }
                },
                {
                  "text": "<div>Osteoarthritis</div>",
                  "correct": true,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>Short morning stiffness (&lt;30 min) that clears quickly, combined with pain worsening after sustained activity, are hallmarks of degenerative (osteo-) arthritis.</div>",
                    "notChosenFeedback": ""
                  }
                },
                {
                  "text": "<div>Ankylosing spondylitis</div>",
                  "correct": false,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>AS causes prolonged morning stiffness of the back that improves with exercise, typically in young men — the opposite of what is described here.</div>",
                    "notChosenFeedback": ""
                  }
                },
                {
                  "text": "<div>Psoriatic arthritis</div>",
                  "correct": false,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>Psoriatic arthritis is an inflammatory condition with prolonged morning stiffness (&gt;60 min) and improvement with movement, not worsening with activity.</div>",
                    "notChosenFeedback": ""
                  }
                }
              ],
              "overallFeedback": [
                {
                  "from": 0,
                  "to": 50,
                  "feedback": "Remember the two key bedside clues: stiffness duration (>60 min = inflammatory, <30 min = degenerative) and activity response (improves with movement = inflammatory, worsens with activity = degenerative)."
                },
                {
                  "from": 51,
                  "to": 100,
                  "feedback": "Correct. Short morning stiffness (<30 min) and pain that worsens with activity point to degenerative arthritis. Inflammatory arthritis shows the reverse: prolonged stiffness (>60 min) and improvement with movement."
                }
              ],
              "behaviour": {
                "enableRetry": true,
