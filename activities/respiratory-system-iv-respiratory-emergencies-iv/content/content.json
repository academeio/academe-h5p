          "displayType": "poster",
          "buttonOnMobile": false,
          "label": "<p>Which otoscopic finding is the most specific for confirming a diagnosis of acute</p>",
          "x": 30,
          "y": 30,
          "width": 40,
          "height": 25,
          "libraryTitle": "Multiple Choice",
          "action": {
            "library": "H5P.MultiChoice 1.16",
            "params": {
              "question": "<p>Which otoscopic finding is the most specific for confirming a diagnosis of acute otitis media?</p>",
              "answers": [
                {
                  "text": "<div>Erythema of the tympanic membrane</div>",
                  "correct": false,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>Tympanic membrane erythema can result from crying, fever, or irritation alone and is not specific for AOM. It must be interpreted alongside other findings.</div>",
                    "notChosenFeedback": ""
                  }
                },
                {
                  "text": "<div>Bulging of the tympanic membrane</div>",
                  "correct": true,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>Correct. Bulging indicates infected fluid under pressure in the middle-ear space, making it the most specific otoscopic sign of AOM.</div>",
                    "notChosenFeedback": ""
                  }
                },
                {
                  "text": "<div>Loss of the cone of light reflex</div>",
                  "correct": false,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>A lost light reflex suggests middle-ear effusion but also occurs in serous otitis media without active infection, making it less specific for AOM.</div>",
                    "notChosenFeedback": ""
                  }
                },
                {
                  "text": "<div>Retraction of the tympanic membrane</div>",
                  "correct": false,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>Retraction indicates negative middle-ear pressure from Eustachian tube dysfunction and is typically seen in chronic conditions, not acute suppurative infection.</div>",
                    "notChosenFeedback": ""
                  }
                }
              ],
              "overallFeedback": [
                {
                  "from": 0,
                  "to": 50,
                  "feedback": "Review the otoscopic triad for AOM: bulging (most specific), erythema, and evidence of effusion. Of these, bulging best indicates active suppurative infection because it shows fluid under pressure."
                },
                {
                  "from": 51,
                  "to": 100,
                  "feedback": "Well done. Bulging of the tympanic membrane is the most specific otoscopic sign because it directly reflects the pathology — purulent fluid accumulating under pressure behind the drum."
                }
              ],
              "behaviour": {
