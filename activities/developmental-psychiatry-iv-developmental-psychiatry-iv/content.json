          "buttonOnMobile": false,
          "label": "<p>Which pair of core symptom domains defines autism spectrum disorder according to</p>",
          "x": 30,
          "y": 30,
          "width": 40,
          "height": 25,
          "libraryTitle": "Multiple Choice",
          "action": {
            "library": "H5P.MultiChoice 1.16",
            "params": {
              "question": "<p>Which pair of core symptom domains defines autism spectrum disorder according to DSM-5?</p>",
              "answers": [
                {
                  "text": "<div>Inattention and hyperactivity-impulsivity</div>",
                  "correct": false,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>These are the two core domains of ADHD, not ASD. ADHD involves difficulty sustaining attention alongside excessive motor activity or impulsive behaviour.</div>",
                    "notChosenFeedback": ""
                  }
                },
                {
                  "text": "<div>Social communication deficits and restricted, repetitive behaviours</div>",
                  "correct": true,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>Correct. ASD is defined by persistent deficits in social communication and interaction, combined with restricted, repetitive patterns of behaviour, interests, or activities.</div>",
                    "notChosenFeedback": ""
                  }
                },
                {
                  "text": "<div>Intellectual deficits and adaptive behaviour limitations</div>",
                  "correct": false,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>These define intellectual disability disorder, not ASD. A person with ASD may have normal or even above-average intelligence.</div>",
                    "notChosenFeedback": ""
                  }
                },
                {
                  "text": "<div>Language delay and sensory processing disorder</div>",
                  "correct": false,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>Language delay and sensory differences can occur in ASD, but they are features within the two core domains, not the domains themselves.</div>",
                    "notChosenFeedback": ""
                  }
                }
              ],
              "overallFeedback": [
                {
                  "from": 0,
                  "to": 50,
                  "feedback": "Review the two core domains of ASD: persistent deficits in social communication and interaction, AND restricted, repetitive patterns of behaviour and interests."
                },
                {
                  "from": 51,
                  "to": 100,
                  "feedback": "Well done. ASD's two domains — social communication deficits and restricted, repetitive behaviours — distinguish it from other neurodevelopmental conditions like ADHD."
                }
              ],
              "behaviour": {
