          "libraryTitle": "Multiple Choice",
          "action": {
            "library": "H5P.MultiChoice 1.16",
            "params": {
              "question": "<p>A pregnant woman's NIPT result indicates a high risk for trisomy 21. What is the most appropriate next step?</p>",
              "answers": [
                {
                  "text": "<div>Reassure her that NIPT is diagnostic with over 99 per cent accuracy</div>",
                  "correct": false,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>NIPT has excellent sensitivity but remains a screening test, not a diagnostic one. High sensitivity does not eliminate false-positive results.</div>",
                    "notChosenFeedback": ""
                  }
                },
                {
                  "text": "<div>Confirm the result with amniocentesis or chorionic villus sampling</div>",
                  "correct": true,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>Correct. NIPT is a screening test. Any high-risk result must be confirmed by an invasive diagnostic procedure that directly analyses fetal chromosomes.</div>",
                    "notChosenFeedback": ""
                  }
                },
                {
                  "text": "<div>Repeat the NIPT after four weeks to verify the result</div>",
                  "correct": false,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>Repeating a screening test does not convert it into a diagnostic test. Invasive testing is required for definitive chromosomal analysis.</div>",
                    "notChosenFeedback": ""
                  }
                },
                {
                  "text": "<div>Proceed directly with preimplantation genetic testing</div>",
                  "correct": false,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>Preimplantation genetic testing screens embryos during IVF before transfer. It cannot diagnose a chromosomal condition in an ongoing pregnancy.</div>",
                    "notChosenFeedback": ""
                  }
                }
              ],
              "overallFeedback": [
                {
                  "from": 0,
                  "to": 50,
                  "feedback": "NIPT is a screening test, not diagnostic. Despite sensitivity exceeding 99 per cent for trisomy 21, false positives can occur. Any high-risk NIPT result requires confirmation by amniocentesis or CVS, which directly analyse fetal chromosomes."
                },
                {
                  "from": 51,
                  "to": 100,
                  "feedback": "Correct. NIPT analyses cell-free fetal DNA in maternal blood with high sensitivity, but it is a screening test. A high-risk result must be confirmed by amniocentesis or CVS, which provide definitive chromosomal diagnosis."
                }
              ],
