          "buttonOnMobile": false,
          "label": "<p>Which of the following statements about non-invasive prenatal testing (NIPT) is </p>",
          "x": 30,
          "y": 30,
          "width": 40,
          "height": 25,
          "libraryTitle": "Multiple Choice",
          "action": {
            "library": "H5P.MultiChoice 1.16",
            "params": {
              "question": "<p>Which of the following statements about non-invasive prenatal testing (NIPT) is correct?</p>",
              "answers": [
                {
                  "text": "<div>It analyses fetal cells obtained directly from chorionic villi</div>",
                  "correct": false,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>NIPT analyses cell-free fetal DNA circulating in maternal blood, not cells from chorionic villi. CVS is the procedure that samples villi.</div>",
                    "notChosenFeedback": ""
                  }
                },
                {
                  "text": "<div>A positive result confirms the diagnosis and no further testing is needed</div>",
                  "correct": false,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>NIPT is a screening test, not a diagnostic one. A positive result must be confirmed by amniocentesis or CVS for a definitive diagnosis.</div>",
                    "notChosenFeedback": ""
                  }
                },
                {
                  "text": "<div>It detects Down syndrome with over 99% sensitivity but remains a screening test</div>",
                  "correct": true,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>NIPT has excellent sensitivity for trisomy 21, but it is still a screening test. Any positive result requires invasive diagnostic confirmation.</div>",
                    "notChosenFeedback": ""
                  }
                },
                {
                  "text": "<div>It is classified as a semi-invasive method of prenatal diagnosis</div>",
                  "correct": false,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>NIPT uses a maternal blood sample and is classified as non-invasive. Preimplantation genetic testing is the semi-invasive method.</div>",
                    "notChosenFeedback": ""
                  }
                }
              ],
              "overallFeedback": [
                {
                  "from": 0,
                  "to": 50,
                  "feedback": "Remember that NIPT analyses cell-free fetal DNA from maternal blood. Despite its high sensitivity, it is a screening test — a positive result must always be confirmed by an invasive diagnostic procedure."
                },
                {
                  "from": 51,
                  "to": 100,
                  "feedback": "Correct! NIPT is highly sensitive for detecting trisomy 21 but remains a screening test. Any positive result requires confirmation with amniocentesis or CVS."
                }
              ],
              "behaviour": {
