          "pause": true,
          "displayType": "poster",
          "buttonOnMobile": false,
          "label": "<p>A 42-year-old non-smoker with alpha-1-antitrypsin deficiency presents with progr</p>",
          "x": 30,
          "y": 30,
          "width": 40,
          "height": 25,
          "libraryTitle": "Multiple Choice",
          "action": {
            "library": "H5P.MultiChoice 1.16",
            "params": {
              "question": "<p>A 42-year-old non-smoker with alpha-1-antitrypsin deficiency presents with progressive dyspnoea. Which pattern and distribution of emphysema is most likely?</p>",
              "answers": [
                {
                  "text": "<div>Centriacinar emphysema, predominantly upper lobes</div>",
                  "correct": false,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>Centriacinar emphysema is caused by cigarette smoking, not alpha-1-antitrypsin deficiency, and characteristically targets the upper lobes.</div>",
                    "notChosenFeedback": ""
                  }
                },
                {
                  "text": "<div>Panacinar emphysema, predominantly lower lobes</div>",
                  "correct": true,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>Correct. Alpha-1-antitrypsin deficiency removes the protective brake on neutrophil elastase, causing uniform destruction across the entire acinus (panacinar pattern), with a predilection for the lower lobes.</div>",
                    "notChosenFeedback": ""
                  }
                },
                {
                  "text": "<div>Centriacinar emphysema, predominantly lower lobes</div>",
                  "correct": false,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>Centriacinar emphysema involves the central portion of the acinus and is smoking-related. It typically affects the upper lobes, not the lower lobes.</div>",
                    "notChosenFeedback": ""
                  }
                },
                {
                  "text": "<div>Panacinar emphysema, predominantly upper lobes</div>",
                  "correct": false,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>Panacinar emphysema is the correct pattern for alpha-1-antitrypsin deficiency, but it characteristically affects the lower lobes, not the upper lobes.</div>",
                    "notChosenFeedback": ""
                  }
                }
              ],
              "overallFeedback": [
                {
                  "from": 0,
                  "to": 50,
                  "feedback": "Recall that alpha-1-antitrypsin deficiency leaves elastase uninhibited, causing panacinar emphysema that preferentially affects the lower lobes. Smoking-related centriacinar emphysema, by contrast, targets the upper lobes."
                },
                {
                  "from": 51,
                  "to": 100,
                  "feedback": "Correct. Remember: smoking causes centriacinar emphysema in the upper lobes; alpha-1-antitrypsin deficiency causes panacinar emphysema in the lower lobes."
                }
              ],
              "behaviour": {
