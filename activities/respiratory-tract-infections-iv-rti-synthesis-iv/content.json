          "pause": true,
          "displayType": "poster",
          "buttonOnMobile": false,
          "label": "<p>Which of the following organisms is the single most common cause of the common c</p>",
          "x": 30,
          "y": 30,
          "width": 40,
          "height": 25,
          "libraryTitle": "Multiple Choice",
          "action": {
            "library": "H5P.MultiChoice 1.16",
            "params": {
              "question": "<p>Which of the following organisms is the single most common cause of the common cold?</p>",
              "answers": [
                {
                  "text": "<div>Streptococcus pneumoniae</div>",
                  "correct": false,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>Incorrect. S. pneumoniae is a leading cause of bacterial sinusitis and pneumonia, not the common cold.</div>",
                    "notChosenFeedback": ""
                  }
                },
                {
                  "text": "<div>Parainfluenza virus</div>",
                  "correct": false,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>Incorrect. Parainfluenza is the classic cause of croup (laryngotracheobronchitis), not the common cold.</div>",
                    "notChosenFeedback": ""
                  }
                },
                {
                  "text": "<div>Rhinovirus</div>",
                  "correct": true,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>Correct! Rhinovirus, with over 100 serotypes, is the single most common cause of the common cold, accounting for the majority of URTIs.</div>",
                    "notChosenFeedback": ""
                  }
                },
                {
                  "text": "<div>Respiratory syncytial virus</div>",
                  "correct": false,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>Incorrect. RSV primarily causes bronchiolitis in infants, not the common cold in the general population.</div>",
                    "notChosenFeedback": ""
                  }
                }
              ],
              "overallFeedback": [
                {
                  "from": 0,
                  "to": 50,
                  "feedback": "The correct answer is rhinovirus. Viruses cause 80–90 % of URTIs, and rhinovirus, with over 100 serotypes, is the single most common culprit."
                },
                {
                  "from": 51,
                  "to": 100,
                  "feedback": "Well recalled! Rhinovirus accounts for the majority of common colds. Its numerous serotypes explain why no effective vaccine exists against it."
                }
              ],
              "behaviour": {
