          "displayType": "poster",
          "buttonOnMobile": false,
          "label": "<p>In a 65-year-old patient with suspected pulmonary embolism and low pre-test prob</p>",
          "x": 30,
          "y": 30,
          "width": 40,
          "height": 25,
          "libraryTitle": "Multiple Choice",
          "action": {
            "library": "H5P.MultiChoice 1.16",
            "params": {
              "question": "<p>In a 65-year-old patient with suspected pulmonary embolism and low pre-test probability, what is the age-adjusted D-dimer cut-off above which CT pulmonary angiography is indicated?</p>",
              "answers": [
                {
                  "text": "<div>500 ng/mL</div>",
                  "correct": false,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>This is the standard D-dimer cut-off. For patients over 50, the age-adjusted cut-off is age × 10 ng/mL, which for a 65-year-old is 650 ng/mL.</div>",
                    "notChosenFeedback": ""
                  }
                },
                {
                  "text": "<div>650 ng/mL</div>",
                  "correct": true,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>Correct. The age-adjusted D-dimer cut-off is age × 10 ng/mL. For a 65-year-old, this equals 650 ng/mL. A value below this in a low-probability patient safely excludes PE without imaging.</div>",
                    "notChosenFeedback": ""
                  }
                },
                {
                  "text": "<div>1000 ng/mL</div>",
                  "correct": false,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>This exceeds the age-adjusted threshold. The formula is age × 10 ng/mL, giving 650 ng/mL for a 65-year-old.</div>",
                    "notChosenFeedback": ""
                  }
                },
                {
                  "text": "<div>325 ng/mL</div>",
                  "correct": false,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>This is too low. The age-adjusted D-dimer cut-off is calculated as age × 10, in ng/mL, giving 650 ng/mL for a 65-year-old.</div>",
                    "notChosenFeedback": ""
                  }
                }
              ],
              "overallFeedback": [
                {
                  "from": 0,
                  "to": 50,
                  "feedback": "The age-adjusted D-dimer cut-off is age × 10 ng/mL. For a 65-year-old, this gives 650 ng/mL. Below this level in a low-probability patient, PE can be safely excluded without imaging."
                },
                {
                  "from": 51,
                  "to": 100,
                  "feedback": "The age-adjusted D-dimer cut-off improves specificity in older patients, reducing unnecessary CT pulmonary angiography without missing clinically significant emboli."
                }
              ],
