          "buttonOnMobile": false,
          "label": "<p>Which organism is the most common cause of bacterial meningitis in children aged</p>",
          "x": 30,
          "y": 30,
          "width": 40,
          "height": 25,
          "libraryTitle": "Multiple Choice",
          "action": {
            "library": "H5P.MultiChoice 1.16",
            "params": {
              "question": "<p>Which organism is the most common cause of bacterial meningitis in children aged 3 months to 18 years in India?</p>",
              "answers": [
                {
                  "text": "<div>Streptococcus pneumoniae</div>",
                  "correct": false,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>S. pneumoniae is the leading cause in adults aged 18–50 years. In Indian children, N. meningitidis predominates.</div>",
                    "notChosenFeedback": ""
                  }
                },
                {
                  "text": "<div>Haemophilus influenzae type b</div>",
                  "correct": false,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>H. influenzae type b was historically important in childhood meningitis but has declined significantly with the introduction of Hib vaccination.</div>",
                    "notChosenFeedback": ""
                  }
                },
                {
                  "text": "<div>Listeria monocytogenes</div>",
                  "correct": false,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>Listeria primarily causes meningitis in neonates (via vertical transmission) and the elderly or immunocompromised — not in children aged 3 months to 18 years.</div>",
                    "notChosenFeedback": ""
                  }
                },
                {
                  "text": "<div>Neisseria meningitidis</div>",
                  "correct": true,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>Correct. In the Indian context, N. meningitidis is the most common cause of bacterial meningitis in children, unlike some Western countries where S. pneumoniae may lead.</div>",
                    "notChosenFeedback": ""
                  }
                }
              ],
              "overallFeedback": [
                {
                  "from": 0,
                  "to": 50,
                  "feedback": "Review the age-specific pattern: neonates → GBS, E. coli, Listeria; Indian children → N. meningitidis; adults → S. pneumoniae; elderly → S. pneumoniae + Listeria."
                },
                {
                  "from": 51,
                  "to": 100,
                  "feedback": "Well done! Knowing the age-specific organisms is essential for choosing correct empirical antibiotics before culture results arrive."
                }
              ],
              "behaviour": {
