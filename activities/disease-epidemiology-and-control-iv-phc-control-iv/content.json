            "params": {
              "question": "<p>What proportion of the global tuberculosis incidence does India contribute?</p>",
              "answers": [
                {
                  "text": "<div>Approximately 10%</div>",
                  "correct": false,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>India's TB burden is considerably larger. India contributes approximately 26% of the global TB incidence, making it the single largest country contributor.</div>",
                    "notChosenFeedback": ""
                  }
                },
                {
                  "text": "<div>Approximately 26%</div>",
                  "correct": true,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>Correct. India contributes approximately 26% of the global TB incidence, with an estimated 2.8 million new cases per year (WHO Global TB Report 2023), making it the largest contributor worldwide.</div>",
                    "notChosenFeedback": ""
                  }
                },
                {
                  "text": "<div>Approximately 40%</div>",
                  "correct": false,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>While India has a massive TB burden, it accounts for approximately 26%, not 40%, of global TB incidence.</div>",
                    "notChosenFeedback": ""
                  }
                },
                {
                  "text": "<div>Approximately 15%</div>",
                  "correct": false,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>India's share is higher than this. At approximately 26% of global incidence with 2.8 million new cases annually, India is the world's largest single-country TB contributor.</div>",
                    "notChosenFeedback": ""
                  }
                }
              ],
              "overallFeedback": [
                {
                  "from": 0,
                  "to": 50,
                  "feedback": "India contributes approximately 26% of the global TB incidence (about 2.8 million new cases per year), making TB control a critical priority at every primary health centre."
                },
                {
                  "from": 51,
                  "to": 100,
                  "feedback": "Well done! India's disproportionately high TB burden — approximately 26% of global incidence — underlines why TB control is a public health priority at every PHC."
