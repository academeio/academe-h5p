          "buttonOnMobile": false,
          "label": "<p>Which group of axillary lymph nodes is typically the first to receive metastatic</p>",
          "x": 30,
          "y": 30,
          "width": 40,
          "height": 25,
          "libraryTitle": "Multiple Choice",
          "action": {
            "library": "H5P.MultiChoice 1.16",
            "params": {
              "question": "<p>Which group of axillary lymph nodes is typically the first to receive metastatic cells from a breast carcinoma?</p>",
              "answers": [
                {
                  "text": "<div>Lateral group</div>",
                  "correct": false,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>The lateral group drains the upper limb along the axillary vein, not the breast.</div>",
                    "notChosenFeedback": ""
                  }
                },
                {
                  "text": "<div>Anterior (pectoral) group</div>",
                  "correct": true,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>Correct. The anterior (pectoral) group drains the breast and anterior chest wall, making it the first station for breast cancer metastasis.</div>",
                    "notChosenFeedback": ""
                  }
                },
                {
                  "text": "<div>Posterior (subscapular) group</div>",
                  "correct": false,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>The posterior group drains the back and posterior shoulder, not the breast.</div>",
                    "notChosenFeedback": ""
                  }
                },
                {
                  "text": "<div>Apical group</div>",
                  "correct": false,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>The apical group sits at the apex and receives lymph from the central group. It is a later station in the drainage hierarchy, not the first.</div>",
                    "notChosenFeedback": ""
                  }
                }
              ],
              "overallFeedback": [
                {
                  "from": 0,
                  "to": 50,
                  "feedback": "The anterior (pectoral) group drains the breast and anterior chest wall. It is the first group to receive metastatic cells, which is why sentinel node biopsy targets this region."
                },
                {
                  "from": 51,
                  "to": 100,
                  "feedback": "Exactly. The anterior (pectoral) group is the sentinel station for breast cancer spread. This is why sentinel node biopsy targets this area."
                }
              ],
