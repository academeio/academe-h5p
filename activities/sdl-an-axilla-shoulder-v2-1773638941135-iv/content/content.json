          "displayType": "poster",
          "buttonOnMobile": false,
          "label": "<p>Which of the following correctly identifies a boundary of the axilla?</p>",
          "x": 30,
          "y": 30,
          "width": 40,
          "height": 25,
          "libraryTitle": "Multiple Choice",
          "action": {
            "library": "H5P.MultiChoice 1.16",
            "params": {
              "question": "<p>Which of the following correctly identifies a boundary of the axilla?</p>",
              "answers": [
                {
                  "text": "<div>The anterior wall is formed by subscapularis and teres major</div>",
                  "correct": false,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>Subscapularis and teres major form the posterior wall. The anterior wall is formed by pectoralis major and pectoralis minor.</div>",
                    "notChosenFeedback": ""
                  }
                },
                {
                  "text": "<div>The base is formed by the clavicle and first rib</div>",
                  "correct": false,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>The clavicle and first rib form the apex (cervicoaxillary canal), not the base. The base is the skin and axillary fascia.</div>",
                    "notChosenFeedback": ""
                  }
                },
                {
                  "text": "<div>The medial wall is formed by the upper ribs and serratus anterior</div>",
                  "correct": true,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>Correct. The serratus anterior lies over the upper ribs, together forming the medial wall of the axillary pyramid.</div>",
                    "notChosenFeedback": ""
                  }
                },
                {
                  "text": "<div>The lateral wall is formed by pectoralis minor</div>",
                  "correct": false,
                  "tipsAndFeedback": {
                    "tip": "",
                    "chosenFeedback": "<div>Pectoralis minor is part of the anterior wall. The lateral wall is the narrowest side, formed by the intertubercular sulcus of the humerus.</div>",
                    "notChosenFeedback": ""
                  }
                }
              ],
              "overallFeedback": [
                {
                  "from": 0,
                  "to": 50,
                  "feedback": "Review the four walls: anterior (pectoralis major and minor), posterior (subscapularis, latissimus dorsi, teres major), medial (upper ribs + serratus anterior), lateral (intertubercular sulcus of humerus)."
                },
                {
                  "from": 51,
                  "to": 100,
                  "feedback": "Well done. The medial wall is ribs plus serratus anterior. Remember: anterior = pectorals, posterior = subscapularis/latissimus/teres major, lateral = humerus."
                }
              ],
              "behaviour": {
